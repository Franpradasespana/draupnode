# Generado por Draupnode (módulo immich). No lo edites a mano: se reescribe al aplicar.
name: dn-immich

services:
  immich-server:
    image: ghcr.io/immich-app/immich-server:v3
    {% if immich_update | bool %}pull_policy: always
    {% endif %}container_name: dn-immich
    restart: unless-stopped
    labels:
      draupnode.proyecto: "{{ draupnode_project }}"
    environment: &env
      DB_HOSTNAME: database
      DB_USERNAME: postgres
      DB_PASSWORD: "{{ immich_db_pass }}"
      DB_DATABASE_NAME: immich
      REDIS_HOSTNAME: redis
      TZ: Europe/Madrid
    volumes:
      - ./library:/data
      - /etc/localtime:/etc/localtime:ro
    depends_on: [redis, database]
    ports:
      - "127.0.0.1:{{ immich_port }}:2283"
{% if (immich_public_port | default(0) | int) > 0 %}      - "{{ immich_public_port }}:2283"
{% endif %}
  immich-machine-learning:
    image: ghcr.io/immich-app/immich-machine-learning:v3
    {% if immich_update | bool %}pull_policy: always
    {% endif %}container_name: dn-immich-ml
    restart: unless-stopped
    environment:
      <<: *env
      MACHINE_LEARNING_MODEL_REVISION: v2
    volumes:
      - model-cache:/cache
  redis:
    image: docker.io/valkey/valkey:9
    container_name: dn-immich-redis
    restart: unless-stopped
    healthcheck:
      test: redis-cli ping | grep -q PONG || exit 1
  database:
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
    container_name: dn-immich-db
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: "{{ immich_db_pass }}"
      POSTGRES_USER: postgres
      POSTGRES_DB: immich
      POSTGRES_INITDB_ARGS: "--data-checksums"
    volumes:
      - ./postgres:/var/lib/postgresql/data
    shm_size: 128mb

volumes:
  model-cache:
