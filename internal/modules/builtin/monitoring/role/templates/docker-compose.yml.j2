# Generado por Draupnode (módulo monitoring). No lo edites a mano: se reescribe.
name: draupnode-monitor

x-dn: &dn
  restart: unless-stopped
  labels:
    draupnode.proyecto: "{{ draupnode_project }}"
  networks: [monitor]

services:
  prometheus:
    <<: *dn
    image: prom/prometheus:v2.55.1
    container_name: dn-prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.retention.time={{ monitoring_retention_days }}d
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prometheus_data:/prometheus
    ports: ["127.0.0.1:{{ monitoring_prometheus_port }}:9090"]

  node-exporter:
    <<: *dn
    image: prom/node-exporter:v1.8.2
    container_name: dn-node-exporter
    command: [--path.rootfs=/host]
    pid: host
    volumes: ["/:/host:ro{{ ',rslave' if monitoring_prop.stdout | default('') is search('shared|slave') else '' }}"]
{% if monitoring_cadvisor | bool %}

  cadvisor:
    <<: *dn
    image: gcr.io/cadvisor/cadvisor:v0.52.1
    container_name: dn-cadvisor
    privileged: true
    devices: [/dev/kmsg]
    command: [--docker_only=true, --housekeeping_interval=15s]
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
{% endif %}
{% if monitoring_pg_dsn | length > 0 %}

  postgres-exporter:
    <<: *dn
    image: quay.io/prometheuscommunity/postgres-exporter:v0.16.0
    container_name: dn-postgres-exporter
    env_file: .env
    networks: [monitor, pg]
{% endif %}

  grafana:
    <<: *dn
    image: grafana/grafana-oss:11.3.1
    container_name: dn-grafana
    env_file: .env
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /var/lib/grafana/dashboards/recursos.json
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - grafana_data:/var/lib/grafana
    ports: ["127.0.0.1:{{ monitoring_grafana_port }}:3000"]

volumes:
  prometheus_data:
  grafana_data:

networks:
  monitor:
    name: dn-monitor
{% if monitoring_pg_dsn | length > 0 %}
  pg:
    name: {{ monitoring_postgres_network }}
    external: true
{% endif %}
