# Generado por Draupnode (módulo monitoring).
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs: [{ targets: ['localhost:9090'] }]
  - job_name: node
    static_configs: [{ targets: ['node-exporter:9100'] }]
{% if monitoring_cadvisor | bool %}
  - job_name: cadvisor
    static_configs: [{ targets: ['cadvisor:8080'] }]
{% endif %}
{% if monitoring_pg_dsn | length > 0 %}
  - job_name: postgres
    static_configs: [{ targets: ['postgres-exporter:9187'] }]
{% endif %}
