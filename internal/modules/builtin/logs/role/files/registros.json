  "title": "Registros de los contenedores",
  "uid": "logs-apps",
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Aplicación",
        "type": "query",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "app",
          "stream": "{job=\"contenedor\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({job=\"contenedor\"}, app)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "buscar",
        "label": "Buscar texto",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Resumen",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "id": 1,
      "title": "Líneas de error por aplicación",
      "description": "Cuenta las líneas que contienen ERROR/CRITICAL/FATAL/Traceback/Exception en el stdout de los contenedores. Es una heurística por texto: no todas las apps usan el mismo formato.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (app) (count_over_time({job=\"contenedor\", app=~\"$app\"} |~ \"(?i)(error|critical|fatal|traceback|exception)\" [$__auto]))",
          "legendFormat": "{{app}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "id": 2,
      "title": "Errores (rango actual)",
      "description": "Total de líneas de error en el rango de tiempo seleccionado.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (app) (count_over_time({job=\"contenedor\", app=~\"$app\"} |~ \"(?i)(error|critical|fatal|traceback|exception)\" [$__range]))",
          "legendFormat": "{{app}}",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Logs en crudo",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "id": 3,
      "title": "Solo errores y avisos",
      "description": "Usa la variable 'Buscar texto' de arriba para filtrar dentro de estos logs.",
      "type": "logs",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"contenedor\", app=~\"$app\"} |~ \"(?i)(error|critical|fatal|traceback|exception|warn)\" |= \"$buscar\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
