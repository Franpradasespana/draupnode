# Generado por Draupnode (módulo mariadb). No lo edites a mano: se reescribe.
name: draupnode-mariadb

services:
  mariadb:
    image: mariadb:{{ mariadb_version }}
    container_name: {{ mariadb_container }}
    restart: unless-stopped
    env_file: .env
    labels:
      draupnode.proyecto: "{{ draupnode_project }}"
    volumes:
      - mariadb_data:/var/lib/mysql
    networks: [{{ mariadb_network }}]
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 12

volumes:
  mariadb_data:

networks:
  {{ mariadb_network }}:
    external: true
