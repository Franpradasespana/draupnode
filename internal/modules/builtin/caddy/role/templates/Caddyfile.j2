# Generado por Draupnode (módulo caddy, proyecto {{ draupnode_project }}). Se reescribe al aplicar.
{
{% if caddy_email %}
	email {{ caddy_email }}
{% endif %}
	admin localhost:2019
}

{% for line in caddy_sites %}
{% set parts = line.split() %}
{{ parts[0] }} {
{% if caddy_compress | bool %}
	encode zstd gzip
{% endif %}
{% if caddy_security_headers | bool %}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
{% endif %}
{% if caddy_forward_auth_to and parts[0] in (caddy_forward_auth | default([])) %}
	forward_auth {{ caddy_forward_auth_to }} {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
{% endif %}
{% if caddy_oauth2_to and parts[0] in (caddy_oauth2 | default([])) %}
	handle /oauth2/* {
		reverse_proxy {{ caddy_oauth2_to }} {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}
	handle {
		forward_auth {{ caddy_oauth2_to }} {
			uri /oauth2/auth
			header_up X-Real-IP {remote_host}
			copy_headers X-Auth-Request-User X-Auth-Request-Email
			@sin_sesion status 401
			handle_response @sin_sesion {
				redir * /oauth2/sign_in?rd={scheme}://{host}{uri} 302
			}
		}
{% if parts[1].startswith('/') %}
		root * {{ parts[1] }}
		file_server
{% else %}
		reverse_proxy {{ parts[1] }}
{% endif %}
	}
{% elif parts[1].startswith('/') %}
	root * {{ parts[1] }}
	file_server
{% else %}
	reverse_proxy {{ parts[1] }}
{% endif %}
	log {
		output file /var/log/caddy/{{ parts[0] }}.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

{% endfor %}
