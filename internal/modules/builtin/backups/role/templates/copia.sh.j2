#!/usr/bin/env bash
# Generado por Draupnode (módulo backups, proyecto {{ draupnode_project }}). Se reescribe al aplicar.
#   copia            hace una copia ahora (es lo que lanza el temporizador)
#   copia snapshots  lista las copias (JSON)
#   copia remoto     lista las copias del destino remoto (JSON)
#   copia ls ID RUTA                          contenido de una carpeta de una copia (JSON)
#   copia dump ID RUTA                        una ruta de una copia, en tar, por la salida
#   copia restaurar ID DESTINO RUTA...        restaura rutas en DESTINO («/» = su sitio)
#   copia restaurar-bd ID VOLCADO CONTENEDOR BASE [sustituir]
#                    restaura una base: en una base nueva (si BASE ya existe, no
#                    hace nada) o, con «sustituir», borrando antes la que hay
set -euo pipefail
umask 077
export RESTIC_REPOSITORY={{ backups_repo | quote }}
export RESTIC_PASSWORD_FILE={{ (draupnode_secrets_dir ~ '/restic') | quote }}
export RESTIC_CACHE_DIR=/var/cache/restic
{% if backups_remote_type != 'no' %}
# Destino remoto (credenciales solo en este fichero, 0700 root).
remoto() {
{% if backups_remote_type == 's3' %}
  AWS_ACCESS_KEY_ID={{ backups_remote_user | quote }} AWS_SECRET_ACCESS_KEY={{ backups_remote_password | default('') | quote }} \
    restic -r {{ ('s3:' ~ backups_remote) | quote }} "$@"
{% elif backups_remote_type == 'rest-server' %}
  restic -r {{ backups_rest_url | quote }}{{ (' --cacert ' ~ (backups_cacert | quote)) if backups_remote_cacert | length > 0 else '' }} "$@"
{% else %}
  restic -r {{ ('sftp:' ~ backups_remote) | quote }} \
    -o sftp.command={{ ('ssh -i ' ~ backups_sftp_key ~ ' -p ' ~ backups_remote_port ~ ' -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=' ~ backups_known_hosts ~ ' ' ~ backups_remote.split(':')[0] ~ ' -s sftp') | quote }} "$@"
{% endif %}
}
{% endif %}

# Validación de lo que llega de Draupnode.
id_ok()   { [[ "$1" =~ ^[0-9a-f]{8,64}$ ]] || { echo "Copia no válida: $1" >&2; exit 2; }; }
ruta_ok() { [[ "$1" == /* && "$1" != *$'\n'* && "$1" != *'/../'* && "$1" != *'/..' ]] || { echo "Ruta no válida: $1" >&2; exit 2; }; }
nombre_ok() { [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,62}$ ]] || { echo "Nombre no válido: $1" >&2; exit 2; }; }

case "${1:-copia}" in
  snapshots) exec restic snapshots --json ;;
  ls) id_ok "$2"; ruta_ok "$3"; exec restic ls --json "$2" "$3" ;;
  dump) id_ok "$2"; ruta_ok "$3"; exec restic dump --archive tar "$2" "$3" ;;
  restaurar)
    id_ok "$2"; ruta_ok "$3"; destino="$3"; id="$2"; shift 3
    inc=(); for r in "$@"; do ruta_ok "$r"; inc+=(--include "$r"); done
    [ -n "${inc[*]:-}" ] || { echo "Elige qué restaurar" >&2; exit 2; }
    mkdir -p "$destino"
    restic restore "$id" --target "$destino" "${inc[@]}"
    exit ;;
  restaurar-bd)
    # VOLCADO: ruta de un .dump (pg_dump -Fc) dentro de la copia.
    id_ok "$2"; ruta_ok "$3"; nombre_ok "$4"; nombre_ok "$5"
    id="$2"; volcado="$3"; ctr="$4"; base="$5"; modo="${6:-nueva}"
    docker inspect --type container "$ctr" >/dev/null 2>&1 || { echo "No existe el contenedor $ctr" >&2; exit 2; }
    dueno=$(basename "$volcado" .dump)
    nombre_ok "$dueno"
    psql() { docker exec -i "$ctr" psql -U postgres -v ON_ERROR_STOP=1 -qAt "$@"; }
    restic cat config >/dev/null  # que la copia se puede abrir, antes de tocar nada
    existe=$(psql -c "SELECT 1 FROM pg_database WHERE datname='$base'")
    if [ "$modo" = sustituir ]; then
      echo "Cerrando las conexiones a $base y borrándola…"
      psql -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='$base' AND pid <> pg_backend_pid()" >/dev/null
      psql -c "DROP DATABASE IF EXISTS \"$base\""
    elif [ -n "$existe" ]; then
      echo "Ya existe una base llamada $base: elige otro nombre." >&2; exit 3
    fi
    # Se crea con el dueño original (el usuario de la app) si existe.
    if [ -n "$(psql -c "SELECT 1 FROM pg_roles WHERE rolname='$dueno'")" ]; then
      psql -c "CREATE DATABASE \"$base\" OWNER \"$dueno\""
    else
      psql -c "CREATE DATABASE \"$base\""
    fi
    restic dump "$id" "$volcado" | docker exec -i "$ctr" pg_restore -U postgres -d "$base" --exit-on-error --no-acl
    echo "Base $base restaurada desde la copia $id."
    exit ;;
{% if backups_remote_type != 'no' %}
  remoto) remoto snapshots --json; exit ;;
{% endif %}
  copia) ;;
  *) echo "Uso: $0 [copia|snapshots{{ '|remoto' if backups_remote_type != 'no' else '' }}]" >&2; exit 2 ;;
esac

log() { echo "[$(date '+%F %T')] $*"; }
fallos=0
etiqueta="draupnode-{{ draupnode_project }}"
{% if backups_postgres | bool %}

# Cada base por separado (pg_dump -Fc: se puede restaurar una sola) más los
# usuarios y permisos (pg_dumpall --globals-only), en una sola copia.
pg={{ backups_postgres_container | quote }}
if docker inspect --type container "$pg" >/dev/null 2>&1; then
  log "Volcando PostgreSQL ($pg)"
  vol="/var/tmp/draupnode-volcado-{{ draupnode_project }}"
  rm -rf "$vol"; mkdir -p "$vol/postgres-$pg"
  trap 'rm -rf "$vol"' EXIT
  if docker exec "$pg" pg_dumpall -U postgres --globals-only > "$vol/postgres-$pg/usuarios-y-permisos.sql"; then
    for db in $(docker exec "$pg" psql -U postgres -qAt -c "SELECT datname FROM pg_database WHERE NOT datistemplate AND datname <> 'postgres'"); do
      docker exec "$pg" pg_dump -U postgres -Fc "$db" > "$vol/postgres-$pg/$db.dump" || { log "FALLO al volcar la base $db"; fallos=1; }
    done
    (cd "$vol" && restic backup --quiet "postgres-$pg" --tag "$etiqueta" --tag postgres) || { log "FALLO al guardar los volcados"; fallos=1; }
  else
    log "FALLO al volcar PostgreSQL"; fallos=1
  fi
  rm -rf "$vol"
fi
{% endif %}
{% if backups_mariadb | bool %}

# MariaDB: una base por fichero .sql (se puede restaurar una sola).
my={{ backups_mariadb_container | quote }}
if docker inspect --type container "$my" >/dev/null 2>&1; then
  log "Volcando MariaDB ($my)"
  volm="/var/tmp/draupnode-volcado-my-{{ draupnode_project }}"
  rm -rf "$volm"; mkdir -p "$volm/mariadb-$my"
  for db in $(docker exec "$my" sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb -uroot -N -e "SHOW DATABASES"' | grep -Ev '^(information_schema|performance_schema|mysql|sys)$'); do
    docker exec "$my" sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb-dump -uroot --single-transaction --routines --triggers --databases "$1"' _ "$db" > "$volm/mariadb-$my/$db.sql" \
      || { log "FALLO al volcar la base $db"; fallos=1; }
  done
  (cd "$volm" && restic backup --quiet "mariadb-$my" --tag "$etiqueta" --tag mariadb) || { log "FALLO al guardar los volcados de MariaDB"; fallos=1; }
  rm -rf "$volm"
fi
{% endif %}
{% if backups_coolify | bool %}

if docker inspect --type container coolify-db >/dev/null 2>&1; then
  log "Volcando la base de datos de Coolify"
  docker exec coolify-db pg_dumpall -U coolify \
    | restic backup --quiet --stdin --stdin-filename coolify-db.sql --tag "$etiqueta" --tag coolify \
    || { log "FALLO al volcar Coolify"; fallos=1; }
  rutas=()
  for r in /data/coolify/source/.env /data/coolify/ssh; do [ -e "$r" ] && rutas+=("$r"); done
  [ -n "${rutas[*]:-}" ] && { restic backup --quiet "${rutas[@]}" --tag "$etiqueta" --tag coolify-archivos || { log "FALLO al copiar Coolify"; fallos=1; }; }
fi
{% endif %}

log "Copiando archivos"
rutas=({{ draupnode_secrets_dir | quote }}{% for p in backups_paths %} {{ p | quote }}{% endfor %})
{% if backups_apps | bool %}
[ -d /srv/draupnode/apps ] && rutas+=(/srv/draupnode/apps)
{% endif %}
existen=()
for r in "${rutas[@]}"; do
  if [ -e "$r" ]; then existen+=("$r"); else log "AVISO: no existe $r (se salta)"; fi
done
restic backup --quiet "${existen[@]}" --tag "$etiqueta" --tag archivos || { log "FALLO al copiar archivos"; fallos=1; }

log "Borrando copias viejas"
restic forget --quiet --prune --keep-daily {{ backups_keep_daily }} --keep-weekly {{ backups_keep_weekly }} --keep-monthly {{ backups_keep_monthly }} \
  || { log "FALLO al borrar copias viejas"; fallos=1; }
{% if backups_check | bool %}
log "Comprobando el repositorio"
restic check --quiet || { log "FALLO: el repositorio tiene errores"; fallos=1; }
{% endif %}
{% if backups_remote_type != 'no' %}

log "Copiando al destino remoto"
if ! remoto cat config >/dev/null 2>&1; then
  log "Creando el repositorio remoto"
  remoto init --copy-chunker-params --from-repo "$RESTIC_REPOSITORY" --from-password-file "$RESTIC_PASSWORD_FILE" >/dev/null || true
fi
if remoto copy --quiet --from-repo "$RESTIC_REPOSITORY" --from-password-file "$RESTIC_PASSWORD_FILE"; then
{% if backups_remote_append_only | bool %}
  : # el destino solo deja añadir: las copias viejas se quedan allí
{% else %}
  remoto forget --quiet --prune --keep-daily {{ backups_keep_daily }} --keep-weekly {{ backups_keep_weekly }} --keep-monthly {{ backups_keep_monthly }} \
    || { log "FALLO al borrar copias viejas en el destino remoto"; fallos=1; }
{% endif %}
else
  log "FALLO al copiar al destino remoto"; fallos=1
fi
{% endif %}

log "$( [ $fallos -eq 0 ] && echo 'Copia terminada.' || echo 'Copia terminada CON FALLOS.' ) $(restic snapshots --json | python3 -c 'import json,sys; print(len(json.load(sys.stdin)), "copias en total")')"
exit $fallos
